 # Conficuração da conexão com SQL Server usando credencias do Windows
 ConnectionStrings__ConexaoPadrao="SEU_SERVIDOR;Database=SEU_DATABASE;Trusted_Connection=True;TrustServerCertificate=True"

 # Configurações da conexão com usuário e senha (autenticação SQL Server)
 connectionStrings__ConexaoPadrao="Server=SEU_SERVIDOR;Database=SEU_DATABASE;User Id=SEU_USUARIO;Password=SUA_SENHA;TrustServerCertificate=True"
 
  

  