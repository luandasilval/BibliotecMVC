@{
    ViewData["Title"] = "Listagem de Livros";
}

@section Styles {
    <link rel="stylesheet" href="~/css/listagem-administrador.css">
}

<partial name="_MenuLateral" />

<main class="conteudo-listagem">

    <section class="cabecalho-pagina">
        <h1>Listar Livros</h1>
        <p>Gerencie e acompanhe os livros cadastrados</p>
    </section>

    <!-- CARD PRINCIPAL -->
    <section class="card-listagem">

        <div class="area-busca">
            <div class="campo-busca">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Buscar livro por nome...">
            </div>

            <button class="botao-filtro">
                <i class="fa-solid fa-sliders"></i>
                <span>Filtros</span>
            </button>
        </div>

        <!-- CABEÇALHO DA LISTA -->
        <div class="cabecalho-lista">
            <h2>Nome</h2>
            <h2>Reservado</h2>
            <h2>Categoria</h2>
            <h2>Editar</h2>
            <h2>Detalhes</h2>
        </div>

        <!-- LIVROS -->
        <div class="lista-livros">

            <article class="livro">

                <p class="nome-livro">O Pequeno Príncipe</p>

                <input type="checkbox" disabled>

                <p class="categoria-livro">Literatura, Fantasia</p>

                <a href="#" class="botao-acao">
                    <i class="fa-solid fa-pen-to-square"></i>
                </a>

                <a href="#" class="botao-acao">
                    <i class="fa-solid fa-circle-info"></i>
                </a>

            </article>

        </div>

        <!-- RODAPÉ DA LISTAGEM -->
        <div class="rodape-listagem">

            <p class="quantidade-livros">Mostrando 1 de 1 livros</p>

            <!-- PAGINAÇÃO -->
            <div class="paginacao">

                <button class="botao-pagina" id="pagina-anterior">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <span class="pagina-atual">1</span>

                <button class="botao-pagina" id="proxima-pagina">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

            </div>
        </div>

    </section>

</main>

